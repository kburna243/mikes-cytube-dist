# Environment Template — Artist OS (Noizy Neighbor Flagship & Multi-Tenant SaaS)
# NIEMALS echte Schlüssel oder Passwörter committen!

# 1. Datenbank (PostgreSQL 16 Pflicht in Produktion, PGlite Fallback nur in Entwicklung)
DATABASE_URL=postgresql://artist_os:CHANGE_ME@127.0.0.1:5432/artist_os

# 2. Authentifizierung & Mandanten-Sicherheit
SESSION_SECRET=bitte-mindestens-32-zeichen-zufalls-secret-hier-eintragen
# Legacy Single-Admin Passwort (wird durch Multi-Role Auth abgelöst, optional für Migration)
ADMIN_PASSWORD=

# 3. Schutzpipeline (Wasserzeichen & Verschlüsselung)
WATERMARK_SECRET=bitte-eigenes-32-zeichen-hmac-secret-fuer-audio-und-bild-wasserzeichen
CONNECTOR_SECRET=bitte-eigenes-32-zeichen-aes-gcm-secret-fuer-connector-accounts

# 4. KI / OmniRoute (Fail-Closed! Nur Text-Prompts, NIEMALS Bilder oder Original-Audio!)
OMNIR_URL=http://host.docker.internal:20128/v1
OMNIR_KEY=
OMNIR_MODELS=bailian-coding-plan/qwen3.7-plus,bailian-coding-plan/qwen3-coder-plus

# 5. Spracherkennung / ASR (Fail-Closed! Nur explizite Sprachnotizen, keine Musik-Masters!)
ASR_URL=http://host.docker.internal:20128/v1
ASR_KEY=
ASR_MODEL=qwen-audio-3.0-asr-flash

# 6. Externe Schutz-Worker (Bild-Scrambler CLIP/SigLIP & Audio-Anti-AI-Perturbation gegen CLAP/EnCodec)
SCRAMBLER_WORKER_URL=http://127.0.0.1:8091
SCRAMBLER_HMAC_SECRET=
SCRAMBLER_WORKER_API_KEY=

# 7. Dateispeicher (Volumes außerhalb des Builds)
UPLOAD_DIR=./data/uploads
VAULT_STORAGE_DIR=./data/vault
ASSETS_DIR=./data/assets
IDEAS_DIR=./data/ideas
MAX_ASSET_BYTES=209715200
FFMPEG_PATH=ffmpeg

# 8. App & Routing
NEXT_PUBLIC_BASE_PATH=
NODE_ENV=development
PORT=3000
