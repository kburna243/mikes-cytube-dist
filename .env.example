# GEMINI_API_KEY: Optional/legacy fallback for local dev tools.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string with Drizzle ORM (REQUIRED)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/federfuehrer"

# SESSION_SECRET: Secret for signing session tokens (REQUIRED, min 32 chars)
SESSION_SECRET="change-me-to-a-random-32-char-string"

# OmniRoute (OpenAI-kompatible KI-Schnittstelle auf eigenem Server)
OMNIR_URL="http://host.docker.internal:20128/v1"
OMNIR_KEY="my-omnir-key"
OMNIR_MODELS="qwen2.5:14b,llama3.1:8b"

# ASR Spracherkennung für Ideen-Kladde (z.B. qwen-audio-3.0-asr-flash über OpenAI-kompatiblen Endpunkt)
ASR_URL="http://host.docker.internal:20128/v1"
ASR_KEY="my-asr-key"
ASR_MODEL="qwen-audio-3.0-asr-flash"

# Dateispeicher-Verzeichnis für Sprachnotizen (Volume)
IDEAS_DIR="./data/ideas"
